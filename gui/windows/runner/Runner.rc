/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
// El de la app (packaging/windows/make-ico.py), también en moss.exe.
IDI_APP_ICON            ICON                    "..\\..\\..\\packaging\\windows\\moss.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// Versión: la de pubspec.yaml, atada a VERSION (prueba chatbot_version). Los
// números llevan el +N como cuarto campo; las cadenas, X.Y.Z como moss.exe.
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#define VERSION_AS_STRING MOSS_VERSION

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Español de México, Unicode; los mismos campos que moss.exe
        // (cmake/windows/version.rc.in).
        BLOCK "080a04b0"
        BEGIN
            VALUE "CompanyName", "Ricky182771" "\0"
            VALUE "FileDescription", "Moss — interfaz gráfica" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "moss-gui" "\0"
            VALUE "LegalCopyright", "© 2026 Ricky182771. Licencia GPL-3.0-or-later." "\0"
            VALUE "OriginalFilename", "moss-gui.exe" "\0"
            VALUE "ProductName", "Moss" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x080a, 1200
    END
END

